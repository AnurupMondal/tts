{
  "name": "hinglish-tts-bot",
  "version": "0.1.0",
  "description": "Discord TTS bot that speaks Roman-typed Hinglish with natural Hindi pronunciation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/bot/deployCommands.ts",
    "deploy-commands:prod": "node dist/bot/deployCommands.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "say": "tsx src/cli/say.ts",
    "eval": "tsx src/cli/eval.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "ffmpeg-static": "^5.3.0",
    "lru-cache": "^11.5.3",
    "opusscript": "^0.0.8",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
