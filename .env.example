# Copy to .env and fill in. Never commit .env.

# --- Discord (Developer Portal → your application) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server instantly while developing
DEV_GUILD_ID=

# --- TTS provider: google | sarvam ---
TTS_PROVIDER=google

# Google Cloud Text-to-Speech (service-account JSON key file)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-credentials.json
GOOGLE_VOICE_HI=hi-IN-Chirp3-HD-Charon
GOOGLE_VOICE_EN=en-IN-Chirp3-HD-Charon
GOOGLE_SPEAKING_RATE=0.75

# Sarvam AI Bulbul (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
SARVAM_PACE=0.75

# --- Behaviour ---
# auto | hinglish | hindi | english (per-server default; change with /tts mode)
DEFAULT_MODE=auto
MAX_QUEUE_SIZE=20
MAX_MESSAGE_LENGTH=300
USER_COOLDOWN_MS=0
CHANNEL_COOLDOWN_MS=0
DUPLICATE_WINDOW_MS=15000
GUILD_RATE_PER_MIN=40

# Transliteration (Google Input Tools) request timeout
TRANSLIT_TIMEOUT_MS=2000

# In-memory audio cache for repeated phrases
TTS_CACHE_TTL_MS=600000
TTS_CACHE_MAX=300

# Where per-server settings are stored (ids and preferences only, never messages)
DATA_DIR=./data
# trace | debug | info | warn | error
LOG_LEVEL=info
